# Kopieer dit bestand naar .env en vul je eigen waarde in. .env staat in .gitignore.
# Hugging Face token (read-rechten). Alleen nodig om gated modellen te downloaden;
# met lokaal gecachete modellen en huggingface.offline: true in config.yaml is het niet nodig.
HF_TOKEN=hf_vul_hier_je_eigen_token_in
